<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>de.privat.hausaufgaben</string>

    <!-- Pfad anpassen: run.sh liegt neben pyproject.toml und exportiert die Zugangsdaten -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/ck/2026/school/hausaufgaben/run.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/ck/2026/school/hausaufgaben</string>

    <!-- uv muss im PATH liegen (Homebrew oder ~/.cargo/bin) -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/Users/ck/.cargo/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>13</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/ck/2026/school/hausaufgaben/run.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ck/2026/school/hausaufgaben/run.log</string>
</dict>
</plist>
